{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix backend install && npm --prefix frontend install",
  "buildCommand": "npm --prefix backend run vercel:build && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist/sarga-frontend/browser",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "backend/node_modules/@prisma/client/**,backend/node_modules/.prisma/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

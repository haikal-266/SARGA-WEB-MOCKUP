// Prisma PostgreSQL Schema for SARGA (Vercel / Production Deployment)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  ANGGOTA
  ADMIN
}

enum VerificationStatus {
  MENUNGGU_VERIFIKASI
  TERVERIFIKASI
  DITOLAK
}

enum ItemStatus {
  TERSEDIA
  DIPINJAM
  PERAWATAN
  DIARSIPKAN
}

enum LoanStatus {
  MENUNGGU
  DISETUJUI
  DITOLAK
  AKTIF
  SELESAI
  DIBATALKAN
}

model Organization {
  id            String         @id @default(uuid())
  name          String
  type          String
  address       String
  contact       String
  inviteCode    String         @unique
  inviteExpires DateTime?
  status        String         @default("Aktif")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users         User[]
  memberships   Membership[]
  items         Item[]
  loans         LoanTransaction[]
  auditLogs     AuditLog[]
  announcements Announcement[]

  @@map("organizations")
}

model User {
  id                 String             @id @default(uuid())
  waNumber           String             @unique
  passwordHash       String
  fullName           String
  address            String
  isPlatformAdmin    Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  memberships        Membership[]
  ownedItems         Item[]             @relation("UserOwnedItems")
  borrowedLoans      LoanTransaction[]  @relation("UserBorrowedLoans")
  lenderLoans        LoanTransaction[]  @relation("UserLenderLoans")
  auditLogs          AuditLog[]         @relation("UserAudits")
  announcements      Announcement[]     @relation("UserAnnouncements")

  primaryOrgId       String?
  primaryOrg         Organization?      @relation(fields: [primaryOrgId], references: [id])

  @@map("users")
}

model Membership {
  id                 String             @id @default(uuid())
  userId             String
  orgId              String
  role               Role               @default(ANGGOTA)
  position           String             @default("Anggota")
  status             VerificationStatus @default(MENUNGGU_VERIFIKASI)
  rejectionReason    String?

  documentType       String?
  documentUrl        String?
  documentName       String?
  documentNote       String?
  address            String?

  joinedAt           DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@map("memberships")
}

model Item {
  id                 String             @id @default(uuid())
  code               String             @unique
  orgId              String
  ownerId            String?
  name               String
  maxDays            Int                @default(3)
  location           String
  status             ItemStatus         @default(TERSEDIA)
  description        String
  contents           String
  instructions       String
  image              String
  isSafeAndReady     Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner              User?              @relation("UserOwnedItems", fields: [ownerId], references: [id], onDelete: SetNull)
  loans              LoanTransaction[]

  @@map("items")
}

model LoanTransaction {
  id                 String             @id @default(uuid())
  orgId              String
  itemId             String
  borrowerId         String
  ownerId            String?
  startDate          DateTime
  endDate            DateTime
  status             LoanStatus         @default(MENUNGGU)
  purpose            String
  rejectionReason    String?
  returnConfirmedAt  DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item               Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  borrower           User               @relation("UserBorrowedLoans", fields: [borrowerId], references: [id], onDelete: Cascade)
  owner              User?              @relation("UserLenderLoans", fields: [ownerId], references: [id], onDelete: SetNull)

  @@map("loan_transactions")
}

model AuditLog {
  id                 String             @id @default(uuid())
  orgId              String
  actorId            String
  action             String
  target             String
  note               String?
  createdAt          DateTime           @default(now())

  organization       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor              User               @relation("UserAudits", fields: [actorId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Announcement {
  id                 String             @id @default(uuid())
  orgId              String
  authorId           String
  title              String
  content            String
  createdAt          DateTime           @default(now())

  organization       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author             User               @relation("UserAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (SQLite local dev, or PostgreSQL URL for Vercel production)
# Contoh PostgreSQL (Neon / Supabase): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=sarga_super_secret_jwt_key_2026_dev
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:4200

# Optional Cloudinary (for production media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

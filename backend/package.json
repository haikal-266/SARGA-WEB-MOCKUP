{
  "name": "sarga-backend",
  "version": "1.0.0",
  "description": "RESTful API backend for SARGA: Platform Peminjaman dan Berbagi Barang Organisasi",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "vercel:build": "prisma generate --schema=prisma/schema.postgres.prisma && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push:prod": "prisma db push --schema=prisma/schema.postgres.prisma",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "pretest": "node scripts/prepare-test-db.js",
    "test": "vitest run"
  },
  "keywords": ["sarga", "express", "typescript", "prisma", "sqlite", "rest-api"],
  "author": "Tim Pengembang SARGA",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.4.0",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}

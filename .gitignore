# ==========================================
# SARGA - Monorepo .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
*/*/node_modules/
.pnp
.pnp.js

# Production & Build Outputs
dist/
*/dist/
build/
*/build/
out/
*/out/

# Angular Cache & Temp
.angular/
*/.angular/

# SQLite Databases & Local Storage
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
backend/prisma/*.db
backend/prisma/*.db-journal

# Environment & Secrets (Keep .env.example tracked)
.env
.env.*
!.env.example
!*/.env.example
*.pem
*.key
*.cert

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python & Context-Mode Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.context_mode/
*/.context_mode/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Configurations
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Development Docs, Specs, Reports & Mockup Prototypes
/docs/
/mockup/
/All Feature.md
/SRS_Sarga_v1.2.md
/SRS_Sarga_v1.2.pdf
/Test Report.md
/index.html

# AI Agent Skills, Plugins & Tooling State
.agents/
.gemini/
.hallmark/
.vercel/
